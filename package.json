{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:prebid && npm run build:loader && vite build",
        "build:prebid": "node scripts/build-prebid.mjs",
        "build:loader": "node scripts/build-loader.mjs",
        "test:browser": "node --test tests/Browser/*.test.js",
        "test:main-website": "node scripts/validate-main-website.mjs && node scripts/test-main-website-worker.mjs",
        "test:static-delivery": "php scripts/validate-static-delivery.php cloudflare-pages-dist",
        "dev": "vite"
    },
    "devDependencies": {
        "axios": "^1.11.0",
        "laravel-vite-plugin": "^2.0.0",
        "vite": "^7.0.7"
    }
}
