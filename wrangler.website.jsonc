{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plain-truth-6412",
  "compatibility_date": "2026-08-22",
  "main": "./website-worker.mjs",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
