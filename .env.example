APP_NAME="Horus Media"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=horus_media
DB_USERNAME=horus_media
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Ad Manager control-plane configuration.
# Store credential files outside the public web directory. The database stores
# only an encrypted reference such as env:GAM_HORUS_SERVICE_ACCOUNT_PATH.
GAM_API_VERSION=v202602
GAM_APPLICATION_NAME="Horus Media Platform"
GAM_HORUS_NETWORK_CODE=
GAM_HORUS_SERVICE_ACCOUNT_PATH=
GAM_SOAP_BASE_URL=https://ads.google.com/apis/ads/publisher
GAM_SOAP_CONNECT_TIMEOUT=10
GAM_SOAP_TIMEOUT=30
GAM_SOAP_WSDL_CACHE=true
GAM_READ_ATTEMPTS=3
GAM_SAFE_WRITE_ATTEMPTS=2
GAM_RETRY_BASE_DELAY_MS=250
GAM_DRY_RUN_DEFAULT=true

# Public Horus Loader and static browser configuration. These files contain no
# credentials and may be served directly by cdn.horusmedia.net.
HORUS_CDN_URL=https://cdn.horusmedia.net
HORUS_STATIC_CONFIG_ROOT=
HORUS_STATIC_CONFIG_PUBLIC_PATH=configs
HORUS_LOADER_URL=https://cdn.horusmedia.net/hm-loader.js
HORUS_GPT_URL=https://securepubads.g.doubleclick.net/tag/js/gpt.js
HORUS_CONFIG_CACHE_TTL=60

VITE_APP_NAME="${APP_NAME}"
