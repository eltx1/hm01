APP_NAME="Horus Media"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.horusmedia.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=app.horusmedia.net
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# Google Ad Manager. Keep the credential JSON outside public_html and commit
# only this empty reference variable. The admin form stores env:GAM_HORUS_SERVICE_ACCOUNT_PATH.
GAM_API_VERSION=v202602
GAM_APPLICATION_NAME="Horus Media Platform"
GAM_HORUS_NETWORK_CODE=
GAM_HORUS_SERVICE_ACCOUNT_PATH=/home/ACCOUNT/private/gam-horus-service-account.json
GAM_SOAP_BASE_URL=https://ads.google.com/apis/ads/publisher
GAM_SOAP_CONNECT_TIMEOUT=10
GAM_SOAP_TIMEOUT=30
GAM_SOAP_WSDL_CACHE=true
GAM_READ_ATTEMPTS=3
GAM_SAFE_WRITE_ATTEMPTS=2
GAM_RETRY_BASE_DELAY_MS=250
GAM_DRY_RUN_DEFAULT=true

# The static config root should map to https://cdn.horusmedia.net/configs/.
# It is public by design and must contain no credentials or private business data.
HORUS_CDN_URL=https://cdn.horusmedia.net
HORUS_STATIC_CONFIG_ROOT=/home/ACCOUNT/domains/cdn.horusmedia.net/public_html/configs
HORUS_STATIC_CONFIG_PUBLIC_PATH=configs
HORUS_LOADER_URL=https://cdn.horusmedia.net/hm-loader.js
HORUS_GPT_URL=https://securepubads.g.doubleclick.net/tag/js/gpt.js
HORUS_CONFIG_CACHE_TTL=60

# Prebid.js source is used only while producing the release artifact. Hostinger
# receives the compiled static asset and does not need Node.js or the source tree.
PREBID_VERSION=11.14.0
PREBID_SOURCE_REPOSITORY=https://github.com/prebid/Prebid.js.git
PREBID_SOURCE_REFERENCE=11.14.0
PREBID_BUILD_VERSION=horus-11.14.0-1
PREBID_AUCTION_TIMEOUT_MS=1200
PREBID_CURRENCY=USD
PREBID_PRICE_GRANULARITY=DENSE
PREBID_GAM_ADVERTISER_NAME="Horus Media Prebid"
PREBID_GAM_ORDER_PREFIX="Horus Prebid"
PREBID_GAM_LINE_ITEM_PRIORITY=12

VITE_APP_NAME="${APP_NAME}"
