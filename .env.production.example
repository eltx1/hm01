# Horus Media production configuration template.
# Copy to the private production environment and replace placeholders there.
# Never commit populated secrets or private Publisher data.

# Application
APP_NAME="Horus Media"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.horusmedia.net
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

# Database
DB_CONNECTION=mysql
DB_URL=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

# Session / cache / queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=app.horusmedia.net
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

CACHE_STORE=database
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
CACHE_PREFIX=

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# Optional Redis backend settings. Leave unused values empty when database
# session/cache/queue drivers are selected above.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# Email delivery. These are placeholders only; replace them privately before
# selecting SMTP in a live environment.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_URL=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=app.horusmedia.net
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
POSTMARK_API_KEY=
RESEND_API_KEY=

# Public Publisher applications remain OFF by default. Configure every required
# legal and Turnstile value below before enabling this switch.
PUBLIC_PUBLISHER_REGISTRATION_ENABLED=false
HORUS_PUBLIC_SUPPORT_URL=

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=app.horusmedia.net
TURNSTILE_ACTION=publisher_registration
TURNSTILE_PROVIDER=cloudflare
TURNSTILE_TIMEOUT_SECONDS=5

PUBLISHER_TERMS_OF_SERVICE_VERSION=
PUBLISHER_TERMS_OF_SERVICE_URL=
PUBLISHER_TERMS_OF_SERVICE_REQUIRED=true
PUBLISHER_PRIVACY_POLICY_VERSION=
PUBLISHER_PRIVACY_POLICY_URL=
PUBLISHER_PRIVACY_POLICY_REQUIRED=true
PUBLISHER_TERMS_VERSION=
PUBLISHER_TERMS_URL=
PUBLISHER_TERMS_REQUIRED=true

# THOTH Publisher Quality Advisor. Provider/model choices remain governed by the
# current application allowlist; there is no invented environment model key.
# Keep provider credentials empty here and populate only in the private runtime.
THOTH_PROVIDER=OPENAI
THOTH_OPENAI_API_KEY=
THOTH_GEMINI_API_KEY=
THOTH_TIMEOUT_SECONDS=20
THOTH_MAX_OUTPUT_TOKENS=1800
THOTH_CONNECTION_MAX_AGE_MINUTES=1440
THOTH_APPLICATION_DOMAIN_VERIFICATION_FRESH_DAYS=7

# Google Ad Manager. Keep the credential JSON outside public_html. The database
# stores only a credential reference such as env:GAM_HORUS_SERVICE_ACCOUNT_PATH.
GAM_APPLICATION_NAME="Horus Media Platform"
GAM_HORUS_NETWORK_CODE=
GAM_HORUS_SERVICE_ACCOUNT_PATH=/home/ACCOUNT/private/gam-horus-service-account.json
GAM_REST_BASE_URL=https://admanager.googleapis.com/v1
GAM_REST_TIMEOUT=30
GAM_SOAP_VERSION_OVERRIDE=
GAM_READ_ATTEMPTS=3
GAM_SAFE_WRITE_ATTEMPTS=2
GAM_RETRY_BASE_DELAY_MS=250
GAM_DRY_RUN_DEFAULT=true

# Supply Chain / ads.txt / sellers.json
SUPPLY_CHAIN_MANAGER_DOMAIN=horusmedia.net
SUPPLY_CHAIN_CONTACT_EMAIL=adops@horusmedia.net
SUPPLY_CHAIN_CONTACT_ADDRESS="Horus Media"
SUPPLY_CHAIN_TAG_ID=
SUPPLY_CHAIN_MANAGED_ADS_TXT_BASE_URL=https://cdn.horusmedia.net
SUPPLY_CHAIN_CANONICAL_SELLERS_JSON_URL=https://horusmedia.net/sellers.json
SUPPLY_CHAIN_SELLERS_JSON_PROXY_TARGET=https://cdn.horusmedia.net/sellers.json

ADS_TXT_CONNECT_TIMEOUT=3
ADS_TXT_TIMEOUT=8
ADS_TXT_MAX_RESPONSE_BYTES=1048576
ADS_TXT_MAX_REDIRECTS=3
ADS_TXT_FRESH_FOR_DAYS=7
ADS_TXT_HISTORY_SNAPSHOTS=30
ADS_TXT_USER_AGENT="HorusMedia-AdsTxt-Compliance/1.1 (+https://horusmedia.net)"
ADS_TXT_CONTACT=
ADS_TXT_CONTACT_REVIEWED=false
ADS_TXT_INVENTORY_PARTNER_DOMAINS=
ADS_TXT_SUBDOMAINS=

# Demand / Prebid runtime controls. Provider credentials themselves remain
# encrypted references in the control plane, not values in public config.
DEMAND_CONNECTION_TIMEOUT=10
DEMAND_REPORT_TIMEOUT=30
DEMAND_CSV_MAX_BYTES=20971520
DEMAND_DIRECT_RENDER_TIMEOUT_MS=2500
HORUS_PREBID_CDN_URL=https://cdn.horusmedia.net
HORUS_PREBID_VERSION=11.14.0
HORUS_PREBID_BUILD_PATH=assets/prebid/horus-prebid.min.js
HORUS_PREBID_SOURCE_PATH=assets/prebid/horus-prebid.js
HORUS_PREBID_DOWNLOAD_URL=https://js-download.prebid.org/download
HORUS_PREBID_TIMEOUT_MS=1200
HORUS_PREBID_CURRENCY=USD

# Public browser delivery. The static config root maps to
# https://cdn.horusmedia.net/configs/ and must contain no credentials/private data.
HORUS_CDN_URL=https://cdn.horusmedia.net
HORUS_LOADER_URL=https://cdn.horusmedia.net/hm-loader.js
HORUS_GPT_URL=https://securepubads.g.doubleclick.net/tag/js/gpt.js
HORUS_CONFIG_CACHE_TTL=60
HORUS_STATIC_DELIVERY_DRIVER=cloudflare-pages-pipeline
HORUS_STATIC_DELIVERY_LOCAL_ROOT=
HORUS_STATIC_DELIVERY_BATCH_INTERVAL_MINUTES=30
HORUS_STATIC_DELIVERY_PROCESS_LOCK_SECONDS=180
HORUS_STATIC_DELIVERY_PENDING_STALE_GRACE_MINUTES=5
HORUS_STATIC_DELIVERY_RETENTION=5
HORUS_STATIC_DELIVERY_MAX_ATTEMPTS=5
HORUS_STATIC_DELIVERY_RETRY_DELAY=300
HORUS_STATIC_DELIVERY_MONTHLY_BUDGET=450
HORUS_STATIC_DELIVERY_EMERGENCY_RESERVE=25
HORUS_STATIC_DELIVERY_BUDGET_WARNING=400
HORUS_STATIC_DELIVERY_FILE_WARNING=18000
HORUS_STATIC_DELIVERY_FILE_LIMIT=20000
HORUS_STATIC_DELIVERY_MAX_FILE_BYTES=26214400
HORUS_STATIC_DELIVERY_DRY_RUN=false
HORUS_EDGE_GITHUB_REPOSITORY=eltx1/hm01
HORUS_EDGE_GITHUB_BRANCH=edge-delivery
HORUS_EDGE_GITHUB_TOKEN_REFERENCE=env:HORUS_EDGE_GITHUB_TOKEN
HORUS_EDGE_GITHUB_TOKEN=
HORUS_EDGE_CONNECT_TIMEOUT=5
HORUS_EDGE_REQUEST_TIMEOUT=20
HORUS_EDGE_READ_ATTEMPTS=3

# Explicit Admin-initiated privacy diagnostics only. Normal publisher traffic
# does not call this endpoint.
PRIVACY_DIAGNOSTIC_ENDPOINT=https://app.horusmedia.net/privacy-diagnostics/report
PRIVACY_DIAGNOSTIC_TTL_MINUTES=10
PRIVACY_DIAGNOSTIC_MAX_BYTES=4096
PRIVACY_PROBE_STALE_DAYS=30
GOOGLE_CMP_EVIDENCE_STALE_DAYS=90

# Reporting / Finance
REPORTING_DEFAULT_CURRENCY=USD
REPORTING_DEFAULT_TIMEZONE=UTC
REPORTING_DEFAULT_PUBLISHER_SHARE_BP=7000
REPORTING_DEFAULT_HORUS_SHARE_BP=3000
REPORTING_DEFAULT_MCM_SHARE_BP=0
REPORTING_DISCREPANCY_WARNING_BP=100
REPORTING_CSV_MAX_BYTES=26214400
REPORTING_RETRY_DELAY_MINUTES=30
REPORTING_HOURLY_LOOKBACK_HOURS=3
REPORTING_DAILY_LOOKBACK_DAYS=2
REPORTING_FINANCIAL_SOURCE_STALE_DAYS=3
REPORTING_STATEMENT_INVOICE_MAX_BYTES=10485760

# Campaign / upload safety
ADVERTISER_CAMPAIGNS_ENABLED=true
CAMPAIGN_CREATIVE_DISK=local
CAMPAIGN_CREATIVE_DIRECTORY=campaign-creatives
HTML5_MAX_FILES=250
HTML5_MAX_UNCOMPRESSED_BYTES=52428800
HTML5_MAX_COMPRESSION_RATIO=100
MALWARE_SCANNER_BINARY=
MALWARE_SCAN_TIMEOUT=30
MALWARE_SCAN_FAIL_CLOSED=true
ADVERTISER_INVOICE_TAX_BPS=0
UPLOAD_CONTRACT_MAX_BYTES=10485760
UPLOAD_INVOICE_MAX_BYTES=10485760
SUPPORT_ATTACHMENT_MAX_BYTES=10485760

# Production security
SECURITY_CSP="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests"
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=()"
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCK_MINUTES=30
AUTH_ADMIN_2FA_REQUIRED=true

# Scheduler / queue operations
HEARTBEAT_STALE_AFTER_SECONDS=180
QUEUE_CRON_MAX_TIME=50
QUEUE_CRON_TRIES=3
ERROR_NOTIFICATION_EMAIL=

# Technical operational retention. Every age is independent and applies only to
# the explicit allowlist in config/data-retention.php; old business data is not
# eligible merely because it exceeds one of these values.
DATA_RETENTION_CHUNK_SIZE=500
DATA_RETENTION_SYNTHETIC_PROBES_DAYS=90
DATA_RETENTION_PRIVACY_DIAGNOSTIC_EVIDENCE_DAYS=365
DATA_RETENTION_PRIVACY_DIAGNOSTIC_TOKEN_GRACE_DAYS=30
DATA_RETENTION_EXPIRED_INVITATIONS_DAYS=180
DATA_RETENTION_COMPLETED_JOB_BATCHES_DAYS=90
DATA_RETENTION_AUDIT_LOGS_DAYS=2555

# Logging / notifications
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=HorusMediaOps
LOG_SLACK_EMOJI=:rotating_light:
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Filesystem. Local private storage is the default. Optional S3 values are kept
# as empty placeholders and must be populated only when S3 is selected.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
